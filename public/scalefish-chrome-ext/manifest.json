{
  "manifest_version": 3,
  "name": "Scalefish Bookmark",
  "version": "2.0.0",
  "description": "Scalefish 书签浏览与保存（与网站共享登录态）",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/s-16.png",
      "48": "icons/s-48.png",
      "128": "icons/s-128.png"
    }
  },
  "icons": {
    "16": "icons/s-16.png",
    "48": "icons/s-48.png",
    "128": "icons/s-128.png"
  }
}
